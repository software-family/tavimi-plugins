{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "tavimi",
            "tool": "signal_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "tavimi",
            "tool": "signal_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "tavimi",
            "tool": "signal_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "tavimi",
            "tool": "signal_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "tavimi",
            "tool": "signal_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
